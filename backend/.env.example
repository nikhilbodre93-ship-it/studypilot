PROJECT_NAME="StudyPilot API"
ENVIRONMENT="production"
# For Neon / Postgres: postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require
# For Local SQLite: sqlite:///./studypilot.db
DATABASE_URL="postgresql://<user>:<password>@<host>/<dbname>?sslmode=require"

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="your-strong-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list or JSON array of allowed origins (e.g. your Vercel deployment URL)
BACKEND_CORS_ORIGINS="http://localhost:5173,https://your-frontend.vercel.app"
RATE_LIMIT_AUTH_PER_MINUTE="60/minute"

# ==========================================
# LLM Provider Configuration:
# Options: mock | gemini | groq | openai | anthropic | ollama
# Note: "mock" works completely offline out-of-the-box with zero API keys required!
# ==========================================
LLM_PROVIDER="mock"

# Google Gemini (Free API Key available from https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Groq (Ultra-fast, free tier available from https://groq.com/)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# Anthropic Claude
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Ollama (Local LLM server)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
